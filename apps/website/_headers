# Cloudflare Pages _headers — served from the deploy root (staged from apps/website/).
#
# Purpose: keep the /legal/* accountability + governance documents out of search
# results. The raw `.md` docs cannot carry a `<meta name="robots">` tag (they are
# not HTML), so the X-Robots-Tag HTTP header is the only lever for them. The portal
# index.html also carries a noindex <meta>; this header makes the policy uniform.
#
# This does NOT block the telemetry release-gate, which fetches these URLs
# server-side (X-Robots-Tag only instructs crawlers, not fetchers).
#
# Security headers (CSP / HSTS / X-Frame-Options / etc.) are applied by the bound
# Cloudflare Worker (cloudflare/worker.js), NOT this file. The comprehensive
# security `_headers` template still lives at cloudflare/_headers (excluded from
# deploy by design); this root file intentionally carries only the /legal/* rule.

/legal/*
  X-Robots-Tag: noindex

# Demo deck — embedded in the homepage hero modal (spec 119). Override the
# zone-level CSP `frame-ancestors 'none'` + `X-Frame-Options: DENY` so the
# /demo/* subtree can be iframed from same-origin pages on keeply.work.
# Same-origin only — cross-origin embedding is still blocked.
/demo/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' https://analytics.ahrefs.com https://www.googletagmanager.com https://static.cloudflareinsights.com https://*.clarity.ms https://cdn.paddle.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com https://*.clarity.ms https://c.bing.com; font-src 'self' data:; connect-src 'self' https://analytics.ahrefs.com https://docs.google.com https://*.google-analytics.com https://*.analytics.google.com https://cloudflareinsights.com https://*.clarity.ms; form-action 'self' https://docs.google.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
